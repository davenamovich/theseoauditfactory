# Environment variables for local development
# These will be overridden by Vercel environment variables on deployment

# Next.js public URL for sitemap/robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MCP API key (set in Vercel dashboard for production)
PNR_MCP_KEY=

# Database URL - set via Vercel environment variables only
# Do not set DATABASE_URL in this file for Vercel deployment
# Use Vercel Dashboard → Settings → Environment Variables instead